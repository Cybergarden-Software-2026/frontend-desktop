{
  "name": "underctrl-desktop",
  "version": "1.0.0",
  "description": "Рабочее место координатора инцидентов UnderCtrl",
  "author": "UnderCtrl",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": { "node": ">=24.0.0" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "pnpm check && vite build",
    "start": "electron .",
    "package:mac": "pnpm build && electron-builder --mac --universal --publish never",
    "package:win": "pnpm build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "45.4.1",
    "electron-builder": "^26.0.0",
    "eslint": "^10.0.0",
    "exceljs": "4.4.0",
    "globals": "^16.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "ru.underctrl.coordinator",
    "productName": "UnderCtrl",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "mac": { "target": "zip", "category": "public.app-category.productivity", "identity": "-", "hardenedRuntime": false, "icon": "build/icon.icns" },
    "win": { "target": "zip", "icon": "build/icon.ico" },
    "artifactName": "UnderCtrl-${version}-${os}-${arch}.${ext}"
  }
}
